# Copy to .env.local and fill in. Server-only — never prefix with NEXT_PUBLIC_.

OPENAI_API_KEY=sk-proj-your-key-here

# Text conversation model.
OPENAI_MODEL=gpt-5.6-luna

# Voice conversation model.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Salt for the one-way hash applied to userId before it is sent to OpenAI as
# safety_identifier. Use a long random string; `openssl rand -hex 32` works.
PRIYA_ID_SALT=replace-with-a-long-random-string

# Supabase. Locally these come from `npx supabase status`; in a hosted project
# they come from the dashboard's API settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only. Bypasses Row Level Security, so it must never carry a
# NEXT_PUBLIC_ prefix and must never reach the browser.
SUPABASE_SECRET_KEY=sb_secret_your_key_here
