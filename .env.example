# Copy to .env.local and fill in. Server-only — never prefix with NEXT_PUBLIC_.

OPENAI_API_KEY=sk-proj-your-key-here

# Text conversation model.
OPENAI_MODEL=gpt-5.6-luna

# Voice conversation model.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Salt for the one-way hash applied to userId before it is sent to OpenAI as
# safety_identifier. Use a long random string; `openssl rand -hex 32` works.
PRIYA_ID_SALT=replace-with-a-long-random-string
